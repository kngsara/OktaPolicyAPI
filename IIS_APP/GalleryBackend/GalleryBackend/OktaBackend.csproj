<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Controllers\GalleryController.cs" />
	  <Compile Remove="GraphQL\CreateGalleryItemInput.cs" />
	  <Compile Remove="GraphQL\GalleryMutation.cs" />
	  <Compile Remove="GraphQL\GalleryQuery.cs" />
	  <Compile Remove="Models\GalleryItem.cs" />
	  <Compile Remove="Services\GalleryImportValidationService.cs" />
	  <Compile Remove="Services\GallerySourceService.cs" />
	  <Compile Remove="Soap\GallerySoapService.cs" />
	  <Compile Remove="Soap\IGallerySoapService.cs" />
	</ItemGroup>

	<ItemGroup>
	  <Content Remove="Schemas\gallery-item.schema.json" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Schemas\gallery-item.xsd" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore" Version="2.80.0" />
		<PackageReference Include="HotChocolate.AspNetCore" Version="16.0.11" />
		<PackageReference Include="JsonSchema.Net" Version="9.2.1" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.11">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="SoapCore" Version="1.2.1.13" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.2" />
		<PackageReference Include="System.ServiceModel.Primitives" Version="8.1.1" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="Protos\weather.proto" GrpcServices="Server" />
	</ItemGroup>

	<ItemGroup>
	  <Content Update="Schemas\okta-policy.schema.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
	  <None Update="Schemas\okta-policy.xsd">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Migrations\" />
	</ItemGroup>

</Project>