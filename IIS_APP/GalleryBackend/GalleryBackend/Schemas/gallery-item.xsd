<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="galleryItem">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="imgurId">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:minLength value="1"/>
              <xs:maxLength value="50"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>

        <xs:element name="title">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:minLength value="1"/>
              <xs:maxLength value="200"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>

        <xs:element name="link">
          <xs:simpleType>
            <xs:restriction base="xs:anyURI"/>
          </xs:simpleType>
        </xs:element>

        <xs:element name="type">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="image/jpeg"/>
              <xs:enumeration value="image/png"/>
              <xs:enumeration value="image/gif"/>
              <xs:enumeration value="video/mp4"/>
              <xs:enumeration value="album"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>

        <xs:element name="views" type="xs:nonNegativeInteger"/>
        <xs:element name="ups" type="xs:nonNegativeInteger"/>
        <xs:element name="downs" type="xs:nonNegativeInteger"/>
        <xs:element name="score" type="xs:integer"/>
        <xs:element name="isAlbum" type="xs:boolean"/>
        <xs:element name="createdAt" type="xs:dateTime"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>