@page "/oktapolicies"
@rendermode InteractiveServer
@using GalleryFrontend.Models
@using GalleryFrontend.Services
@inject OktaPolicyApiService OktaPolicyApiService
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<h3>Okta Policies</h3>

@if (!AuthState.IsLoggedIn)
{
    <p>Niste prijavljeni.</p>
    <a class="btn btn-primary" href="/login">Idi na login</a>
}
else
{
    <button class="btn btn-outline-danger mb-3 ms-2" @onclick="Logout">Logout</button>

    <div class="alert alert-info">
        Prijavljena uloga: <strong>@AuthState.Role</strong>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            DHMZ temperatura po gradu
        </div>

        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label>Grad ili dio naziva grada</label>
                    <input class="form-control" @bind="weatherSearchTerm" placeholder="npr. zag, split, rijeka" />
                </div>

                <div class="col-md-2">
                    <button class="btn btn-primary" @onclick="SearchWeatherAsync">
                        Pretraži
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(weatherMessage))
            {
                <p class="text-muted mt-3">@weatherMessage</p>
            }

            @if (weatherResults.Any())
            {
                <table class="table table-sm table-bordered mt-3">
                    <thead>
                        <tr>
                            <th>Grad</th>
                            <th>Temperatura</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var weather in weatherResults)
                        {
                            <tr>
                                <td>@weather.City</td>
                                <td>@weather.Temperature °C</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            SOAP pretraga Okta policies
        </div>

        <div class="card-body">
            <p>
                SOAP servis pretražuje XML datoteku <code>okta-policies.xml</code> pomoću XPath-a.
            </p>

            @if (AuthState.IsFullAccess)
            {
                <button class="btn btn-warning mb-3" @onclick="ExportXmlAsync">
                    Generiraj XML za SOAP
                </button>
            }
            else
            {
                <p class="text-muted">
                    XML export je dostupan samo korisniku s FullAccess ulogom.
                </p>
            }

            @if (!string.IsNullOrWhiteSpace(exportXmlMessage))
            {
                <p class="text-muted">@exportXmlMessage</p>
            }

            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label>Pojam za pretragu</label>
                    <input class="form-control" @bind="soapSearchTerm" placeholder="npr. ACTIVE local, OKTA_SIGN_ON gql, Default" />
                </div>

                <div class="col-md-2">
                    <button class="btn btn-primary" @onclick="SearchSoapAsync">
                        Pretraži SOAP
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(soapMessage))
            {
                <p class="text-muted mt-3">@soapMessage</p>
            }

            @if (soapResults.Any())
            {
                <table class="table table-sm table-bordered mt-3">
                    <thead>
                        <tr>
                            <th>Okta ID</th>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Link</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var policy in soapResults)
                        {
                            <tr>
                                <td>@policy.OktaId</td>
                                <td>@policy.Name</td>
                                <td>@policy.Type</td>
                                <td>@policy.Status</td>
                                <td>@policy.Priority</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(policy.Link))
                                    {
                                        <a href="@policy.Link" target="_blank">Otvori</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            GraphQL dohvat Okta policies
        </div>

        <div class="card-body">
            <button class="btn btn-primary" @onclick="LoadGraphQlPoliciesAsync">
                Učitaj preko GraphQL
            </button>

            @if (!string.IsNullOrWhiteSpace(graphQlMessage))
            {
                <p class="text-muted mt-3">@graphQlMessage</p>
            }

            @if (graphQlPolicies.Any())
            {
                <table class="table table-sm table-bordered mt-3">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Okta ID</th>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Link</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var policy in graphQlPolicies)
                        {
                            <tr>
                                <td>@policy.Id</td>
                                <td>@policy.OktaId</td>
                                <td>@policy.Name</td>
                                <td>@policy.Type</td>
                                <td>@policy.Status</td>
                                <td>@policy.Priority</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(policy.Link))
                                    {
                                        <a href="@policy.Link" target="_blank">Otvori</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>


    @if (AuthState.IsFullAccess)
    {
        <div class="card mb-4">
            <div class="card-header">
                Dodaj lokalni Okta Policy
            </div>

            <div class="card-body">
                <div class="row g-2">
                    <div class="col-md-4">
                        <label>Okta ID</label>
                        <input class="form-control" @bind="newPolicy.OktaId" />
                    </div>

                    <div class="col-md-4">
                        <label>Name</label>
                        <input class="form-control" @bind="newPolicy.Name" />
                    </div>

                    <div class="col-md-4">
                        <label>Type</label>
                        <input class="form-control" @bind="newPolicy.Type" />
                    </div>

                    <div class="col-md-3">
                        <label>Status</label>
                        <input class="form-control" @bind="newPolicy.Status" />
                    </div>

                    <div class="col-md-3">
                        <label>Priority</label>
                        <input type="number" class="form-control" @bind="newPolicy.Priority" />
                    </div>

                    <div class="col-md-6">
                        <label>Link</label>
                        <input class="form-control" @bind="newPolicy.Link" />
                    </div>
                </div>

                <button class="btn btn-success mt-3" @onclick="CreatePolicyAsync">
                    Dodaj
                </button>

                @if (!string.IsNullOrWhiteSpace(createMessage))
                {
                    <p class="text-muted mt-3">@createMessage</p>
                }
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            ReadOnly korisnik može samo pregledavati Okta policies.
        </div>
    }

    @if (policies == null)
    {
        <p>Učitavanje...</p>
    }
    else if (!policies.Any())
    {
        <p>Nema policy zapisa.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Okta ID</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Created</th>
                    <th>Link</th>
                    @if (AuthState.IsFullAccess)
                    {
                        <th>Akcije</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var policy in policies)
                {
                    if (editingPolicyId == policy.Id)
                    {
                        <tr>
                            <td>@policy.Id</td>
                            <td>
                                <input class="form-control form-control-sm" @bind="editPolicy.OktaId" />
                            </td>
                            <td>
                                <input class="form-control form-control-sm" @bind="editPolicy.Name" />
                            </td>
                            <td>
                                <input class="form-control form-control-sm" @bind="editPolicy.Type" />
                            </td>
                            <td>
                                <input class="form-control form-control-sm" @bind="editPolicy.Status" />
                            </td>
                            <td>
                                <input type="number" class="form-control form-control-sm" @bind="editPolicy.Priority" />
                            </td>
                            <td>@editPolicy.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <input class="form-control form-control-sm" @bind="editPolicy.Link" />
                            </td>
                            @if (AuthState.IsFullAccess)
                            {
                                <td>
                                    <button class="btn btn-sm btn-success me-1" @onclick="SaveEditAsync">
                                        Spremi
                                    </button>
                                    <button class="btn btn-sm btn-secondary" @onclick="CancelEdit">
                                        Odustani
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td>@policy.Id</td>
                            <td>@policy.OktaId</td>
                            <td>@policy.Name</td>
                            <td>@policy.Type</td>
                            <td>@policy.Status</td>
                            <td>@policy.Priority</td>
                            <td>@policy.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(policy.Link))
                                {
                                    <a href="@policy.Link" target="_blank">Otvori</a>
                                }
                            </td>
                            @if (AuthState.IsFullAccess)
                            {
                                <td>
                                    @if (policy.Id > 0)
                                    {
                                        <button class="btn btn-sm btn-primary me-1" @onclick="() => StartEdit(policy)">
                                            Uredi
                                        </button>

                                        <button class="btn btn-sm btn-danger" @onclick="() => DeletePolicyAsync(policy.Id)">
                                            Obriši
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Vanjski API</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
}

@code {
    private List<OktaPolicy>? policies;
    private int? editingPolicyId = null;

    private OktaPolicy editPolicy = new();

    private string createMessage = string.Empty;

    private string soapSearchTerm = "ACTIVE";
    private string soapMessage = string.Empty;
    private List<SoapOktaPolicy> soapResults = new();

    private string exportXmlMessage = string.Empty;

    private string graphQlMessage = string.Empty;
    private List<OktaPolicy> graphQlPolicies = new();


    private OktaPolicy newPolicy = new()
    {
        OktaId = "local-policy-001",
        Name = "Local Sign On Policy",
        Type = "OKTA_SIGN_ON",
        Status = "ACTIVE",
        Priority = 1,
        Link = "",
        LastUpdatedAt = DateTime.UtcNow
    };

    private string weatherSearchTerm = "zag";
    private string weatherMessage = string.Empty;
    private List<WeatherInfo> weatherResults = new();


    protected override async Task OnInitializedAsync()
    {
        if (AuthState.IsLoggedIn)
        {
            await LoadPoliciesAsync();
        }
    }

    private async Task LoadPoliciesAsync()
    {
        policies = await OktaPolicyApiService.GetOktaPoliciesAsync();
    }

    private async Task CreatePolicyAsync()
    {
        createMessage = string.Empty;

        newPolicy.CreatedAt = DateTime.UtcNow;
        newPolicy.LastUpdatedAt = DateTime.UtcNow;
        if (string.IsNullOrWhiteSpace(newPolicy.Link))
        {
            newPolicy.Link = $"https://integrator-9899736.okta.com/api/v1/policies/{newPolicy.OktaId}";
        }

        var success = await OktaPolicyApiService.CreateOktaPolicyAsync(newPolicy);

        if (success)
        {
            createMessage = "Policy je uspješno dodan.";

            newPolicy = new OktaPolicy
            {
                OktaId = "local-policy-001",
                Name = "Local Sign On Policy",
                Type = "OKTA_SIGN_ON",
                Status = "ACTIVE",
                Priority = 1,
                Link = "https://localhost/local-policy-001",
                CreatedAt = DateTime.UtcNow,
                LastUpdatedAt = DateTime.UtcNow
            };

            await LoadPoliciesAsync();
        }
        else
        {
            createMessage = "Dodavanje policyja nije uspjelo.";
        }
    }

    private async Task DeletePolicyAsync(int id)
    {
        var success = await OktaPolicyApiService.DeleteOktaPolicyAsync(id);

        if (success)
        {
            await LoadPoliciesAsync();
        }
    }

    private void Logout()
    {
        AuthState.Logout();
        Navigation.NavigateTo("/login");
    }

    private async Task SearchWeatherAsync()
    {
        weatherMessage = string.Empty;
        weatherResults.Clear();

        if (string.IsNullOrWhiteSpace(weatherSearchTerm))
        {
            weatherMessage = "Unesi naziv grada ili dio naziva grada.";
            return;
        }

        weatherResults = await OktaPolicyApiService.GetWeatherByCityAsync(weatherSearchTerm);

        if (!weatherResults.Any())
        {
            weatherMessage = "Nema pronađenih gradova za uneseni pojam.";
        }
    }

    private async Task SearchSoapAsync()
    {
        soapMessage = string.Empty;
        soapResults.Clear();

        if (string.IsNullOrWhiteSpace(soapSearchTerm))
        {
            soapMessage = "Unesi pojam za SOAP pretragu.";
            return;
        }

        soapResults = await OktaPolicyApiService.SearchOktaPoliciesSoapAsync(soapSearchTerm);

        if (!soapResults.Any())
        {
            soapMessage = "Nema SOAP rezultata za uneseni pojam. Prvo provjeri je li generiran XML export.";
        }
    }

    private async Task ExportXmlAsync()
    {
        exportXmlMessage = await OktaPolicyApiService.ExportOktaPoliciesXmlAsync();
    }

    private async Task LoadGraphQlPoliciesAsync()
    {
        graphQlMessage = string.Empty;
        graphQlPolicies.Clear();

        graphQlPolicies = await OktaPolicyApiService.GetOktaPoliciesGraphQlAsync();

        if (!graphQlPolicies.Any())
        {
            graphQlMessage = "GraphQL nije vratio nijedan Okta policy zapis.";
        }
    }

    private void StartEdit(OktaPolicy policy)
    {
        editingPolicyId = policy.Id;

        editPolicy = new OktaPolicy
        {
            Id = policy.Id,
            OktaId = policy.OktaId,
            Name = policy.Name,
            Type = policy.Type,
            Status = policy.Status,
            Priority = policy.Priority,
            Link = policy.Link,
            CreatedAt = policy.CreatedAt,
            LastUpdatedAt = DateTime.UtcNow
        };
    }

    private void CancelEdit()
    {
        editingPolicyId = null;
        editPolicy = new OktaPolicy();
    }

    private async Task SaveEditAsync()
    {
        if (editingPolicyId == null)
        {
            return;
        }

        editPolicy.LastUpdatedAt = DateTime.UtcNow;

        var success = await OktaPolicyApiService.UpdateOktaPolicyAsync(editingPolicyId.Value, editPolicy);

        if (success)
        {
            editingPolicyId = null;
            editPolicy = new OktaPolicy();

            await LoadPoliciesAsync();
        }
    }
}